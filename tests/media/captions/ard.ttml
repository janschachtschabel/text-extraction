<?xml version="1.0" encoding="utf-8"?>
<tt:tt xmlns:tt="http://www.w3.org/ns/ttml"
       xmlns:tts="http://www.w3.org/ns/ttml#styling"
       xmlns:ttp="http://www.w3.org/ns/ttml#parameter"
       xmlns:ebuttm="urn:ebu:tt:metadata"
       xml:lang="de" ttp:timeBase="media" ttp:cellResolution="50 30">
  <tt:head>
    <tt:metadata>
      <ebuttm:documentMetadata>
        <ebuttm:documentEbuttVersion>v1.0</ebuttm:documentEbuttVersion>
      </ebuttm:documentMetadata>
    </tt:metadata>
    <tt:styling>
      <tt:style xml:id="sWhite" tts:color="#ffffff" tts:backgroundColor="#000000"/>
      <tt:style xml:id="sYellow" tts:color="#ffff00" tts:backgroundColor="#000000"/>
    </tt:styling>
    <tt:layout>
      <tt:region xml:id="bottom" tts:origin="10% 80%" tts:extent="80% 15%"/>
    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div>
      <tt:p xml:id="sub1" begin="00:00:01.200" end="00:00:04.040" region="bottom">
        <tt:span style="sYellow">Guten Abend, meine Damen und Herren.</tt:span><tt:br/><tt:span style="sWhite">Willkommen zur Sendung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" begin="00:00:04.500" dur="2.5s" region="bottom">
        <tt:span style="sWhite">Heute: Forschung &amp; Lehre</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" begin="00:00:08.000" end="00:00:10.000" region="bottom">
        <tt:span style="sYellow"><tt:span style="sWhite">Verschachtelt</tt:span> und
        <tt:span>über mehrere Zeilen.</tt:span></tt:span>
      </tt:p>
      <tt:p xml:id="sub4" begin="00:00:11.000" end="00:00:12.000"/>
    </tt:div>
  </tt:body>
</tt:tt>
